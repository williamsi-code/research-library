generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Topic {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt      DateTime        @default(now())
  conceptMap     Json?
  conceptMapAt   DateTime?
  explanationDraft String?
  explanationChecks ExplanationCheck[]
  sources        Source[]
  notes          Note[]
  researchItems  ResearchItem[]
  timelineEvents TimelineEvent[]
  quizQuestions  QuizQuestion[]
}

model Source {
  id              String       @id @default(cuid())
  title           String
  author          String?
  siteName        String?
  kind            String // web | pdf | text | scan | video | audio
  url             String?
  publishedAt     String?
  filePath        String?
  fileName        String?
  mimeType        String?
  text            String
  segments        Json         @default("[]")
  excerpt         String?
  whySaved        String?
  summary         String?
  status          String       @default("to_read") // to_read | reading | read | archived
  tags            String[]     @default([])
  topicId         String?
  topic           Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  processing      String       @default("pending") // pending | processing | ready | failed
  processingError String?
  pendingOcr      Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  chunks          Chunk[]
  highlights      Highlight[]
  noteLinks       NoteSource[]
  timelineEvents  TimelineEvent[]
  quizQuestions   QuizQuestion[]

  @@index([topicId])
  @@index([url])
}

model Chunk {
  id        String                       @id @default(cuid())
  sourceId  String
  source    Source                       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idx       Int
  startPos  Int
  endPos    Int
  text      String
  location  String?
  embedding Unsupported("vector(1536)")?

  @@index([sourceId])
}

model Highlight {
  id             String    @id @default(cuid())
  sourceId       String
  source         Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  quote          String
  startPos       Int?
  endPos         Int?
  location       String?
  note           String?
  tags           String[]  @default([])
  createdAt      DateTime  @default(now())
  lastReviewedAt DateTime?
  reviewCount    Int       @default(0)

  @@index([sourceId])
}

model Note {
  id        String       @id @default(cuid())
  title     String
  body      String       @default("")
  tags      String[]     @default([])
  topicId   String?
  topic     Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sources   NoteSource[]

  @@index([topicId])
}

model NoteSource {
  noteId   String
  sourceId String
  note     Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([noteId, sourceId])
}

model ResearchItem {
  id          String    @id @default(cuid())
  topicId     String
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  text        String
  note        String?
  done        Boolean   @default(false)
  aiSuggested Boolean   @default(false)
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  @@index([topicId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  dateLabel   String
  sortValue   Float?
  title       String
  description String?
  sourceId    String?
  source      Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  startPos    Int?
  endPos      Int?
  location    String?
  aiExtracted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([topicId])
}

model QuizQuestion {
  id           String    @id @default(cuid())
  topicId      String
  topic        Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  kind         String // multiple_choice | recall
  question     String
  options      Json      @default("[]")
  answerIndex  Int?
  answer       String?
  explanation  String?
  sourceId     String?
  source       Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  startPos     Int?
  endPos       Int?
  location     String?
  timesAsked   Int       @default(0)
  timesCorrect Int       @default(0)
  lastAskedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([topicId])
}

model ExplanationCheck {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  body      String
  result    Json
  createdAt DateTime @default(now())

  @@index([topicId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
